{
  "schema": "rstyle.clones-capability.acceptance/1",
  "scope": {
    "manifest": "corpus/Cargo.toml",
    "package": "clones-capability-acceptance",
    "target": "lib",
    "features": [],
    "extraction_profile": "hir-data-v3",
    "policy": {"max_lines": 5, "max_params": 4, "count_self": false}
  },
  "source_cases": [
    {"function": "source_rules::length_at_limit", "code_lines": 5, "parameters": 1, "length": "evaluated-no-finding", "parameter_count": "evaluated-no-finding"},
    {"function": "source_rules::length_over_limit", "code_lines": 6, "parameters": 1, "length": "finding", "parameter_count": "evaluated-no-finding"},
    {"function": "source_rules::parameters_at_limit", "code_lines": 3, "parameters": 4, "length": "evaluated-no-finding", "parameter_count": "evaluated-no-finding"},
    {"function": "source_rules::parameters_over_limit", "code_lines": 3, "parameters": 5, "length": "evaluated-no-finding", "parameter_count": "finding"},
    {"function": "source_rules::unsupported_body_parameters", "code_lines": 4, "parameters": 5, "length": "evaluated-no-finding", "parameter_count": "finding", "strict_graph": "excluded", "limitation": "closure body is unsupported; this must not suppress usable source/signature checks"}
  ],
  "strict_pair_cases": [
    {"left": "strict_pairs::above_left", "right": "strict_pairs::above_right", "expected": "accepted", "reason": "same ordered u32 inputs and comparison; only binder spellings differ", "abstraction_label": "not-assessed"}
  ],
  "abstraction_cases": [
    {"left": "negative_abstraction::forward_left", "right": "negative_abstraction::forward_right", "expected": "no-proposal", "reason": "identity forwarding adds no useful reusable computation; pair similarity alone is insufficient"}
  ],
  "prepared_guard_cases": [
    {"function": "future_guards::nested_positive", "expected": "advisory-opportunity", "reason": "invert the single condition and return the trivial alternate before the main branch"},
    {"function": "future_guards::already_flat", "expected": "no-finding", "reason": "the early-return guard is already present"},
    {"function": "future_guards::both_branches_do_work", "expected": "no-finding", "reason": "neither branch is a trivial exit; flattening is not this bounded rule"}
  ],
  "prepared_difference_cases": [
    {"left": "future_differences::add_one", "right": "future_differences::add_two", "expected": "literal-hole", "reason": "same operator and formal argument role; only integer literal differs"},
    {"left": "future_differences::subtract_original", "right": "future_differences::subtract_reordered", "expected": "ordered-operand-difference", "reason": "noncommutative operands were swapped; do not claim equivalence or silently align by unordered labels"}
  ]
}
