{
  "schema": "rstyle.clones-capability.static-density-acceptance/1",
  "metric": "rstyle.static-effect-events/1",
  "policy": {
    "max_density_milli": 500,
    "min_statements": 0,
    "min_lines": 0,
    "weights": {
      "mutation": 1,
      "io": 3,
      "time": 1
    }
  },
  "contract": "Original static source events, not runtime effects or purity. Numeric ratios require complete event and source inventories.",
  "cases": [
    {
      "id": "repeated-root",
      "source": "pub fn leaf(t:&mut u32){*t=1;*t=2;}",
      "expected": {
        "events": {
          "mutation": 1
        },
        "statements": 2,
        "actual": 500,
        "outcome": "evaluated_no_finding"
      }
    },
    {
      "id": "delegated-occurrences",
      "source": "fn leaf(t:&mut u32){*t=1;*t=2;} pub fn caller(t:&mut u32){*t=0;leaf(t);leaf(t);}",
      "owner": "caller",
      "expected": {
        "events": {
          "mutation": 3
        },
        "statements": 3,
        "actual": 1000,
        "outcome": "finding"
      }
    },
    {
      "id": "local-kind-propagation",
      "source": "fn leaf(){} fn wrapper(){leaf();leaf();} pub fn caller(){wrapper();}",
      "paths": {
        "io": [
          "wrapper"
        ],
        "time": [
          "leaf"
        ]
      },
      "expected": {
        "wrapper": {
          "events": {
            "time": 2
          },
          "statements": 2,
          "actual": 1000
        },
        "caller": {
          "events": {
            "io": 1,
            "time": 1
          },
          "statements": 1,
          "actual": 4000
        }
      }
    },
    {
      "id": "safe-classified-external",
      "source": "pub fn caller(){std::thread::yield_now();}",
      "paths": {
        "time": [
          "std::thread::yield_now"
        ]
      },
      "expected": {
        "density_complete": true,
        "scalar_mutations_complete": false,
        "events": {
          "time": 1
        },
        "statements": 1,
        "actual": 1000
      }
    },
    {
      "id": "never-result",
      "source": "pub fn caller(){std::process::abort();}",
      "expected": {
        "events": {
          "io": 1
        },
        "statements": 1,
        "actual": 3000
      }
    },
    {
      "id": "unknown-zero-weight",
      "source": "pub fn caller(){std::thread::yield_now();}",
      "weights": {
        "unknown": 0
      },
      "min_statements": 100,
      "expected": {
        "complete": false,
        "actual": null,
        "exempt": false,
        "outcome": "not_evaluated"
      }
    }
  ],
  "required_negative_controls": [
    "missing native safety",
    "contradictory path/result",
    "opaque macros",
    "nested external arguments",
    "mutable external arguments",
    "third call edge",
    "budget exhaustion",
    "suppression cannot repair missing evidence"
  ],
  "validation": "Real Cargo CLI cases in tests/migration_effects/density.rs plus native call metadata tests and numeric overflow tests. No Go comparison or legacy retirement claim."
}
