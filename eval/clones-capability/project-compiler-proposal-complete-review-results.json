      "result": "structural_agreement",
      "reason": null,
      "unit": 0,
      "index": 2,
      "judgment": "not_useful",
      "rationale": "Manual counters remove initialization/increment nodes and rewire data reads; loop guards validate bound/comparison ownership, remove guards and rewire control edges. Both already share rewire. The observed iterator shell hides different closure computations; zero recorded substitutions do not establish shared behavior.",
      "expected_outcome": "structural_agreement",
      "expected_fulfilled": true
    },
    {
