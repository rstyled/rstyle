    },
    {
      "id": "distinct-recursive-tree-predicates",
      "result": "structural_agreement",
      "reason": null,
      "unit": 0,
      "index": 1,
      "judgment": "not_useful",
      "rationale": "Constant trees require exclusive consumers and literal/constructor leaves. Predicate trees accept call leaves and logical combinators without the same ownership requirement. The callee substitution misses closure-body differences; a generic recursive validator would add policy callbacks around two short domain predicates.",
      "expected_outcome": "structural_agreement",
      "expected_fulfilled": true
    },
    {
