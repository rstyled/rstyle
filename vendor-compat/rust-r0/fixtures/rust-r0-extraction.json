    "matching_labels": {"declaration": "DECL", "assignment": "ASSIGN", "control": "CTRL", "call": "STATE", "read": "OTHER", "computation": "OTHER", "formal_input": "OTHER", "return": "OTHER", "formal_output": "OTHER", "merge": "OTHER", "other": "OTHER"},
    "edge_labels": "Preserve data/control/execution and direction independently of coincident node labels; preserve multiplicity. Boundary removal drops incident edges without splicing. No formal_output graph nodes occur in R0."
  },
