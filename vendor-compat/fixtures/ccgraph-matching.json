  "future_harness_requirements": [
    {"id":"all-nine-features","expected":"No omitted coordinate or unknown-to-zero coercion; five node counts sum to projected size."},
    {"id":"unknown-reference-count","expected":"Ineligible with diagnostic; known zero remains a legitimate count."},
    {"id":"unknown-interface","expected":"Ineligible with diagnostic; verified empty interface is serialized as []."},
    {"id":"invalid-source-or-reference","expected":"Schema and semantic validation reject dangling/duplicate IDs, stale source identity and invalid spans."},
    {"id":"required-normal-flow-unknown","expected":"Ineligible; normal-flow policy does not excuse missing required facts."},
    {"id":"known-exceptional-omission","expected":"Partial CFG evidence may coexist with verified bounded normal-flow conformance; no complete exceptional-flow claim."},
    {"id":"native-width-target-mismatch","expected":"Pair ineligible if native-width semantics are involved across different known pointer widths."},
    {"id":"metadata-invariance","expected":"Navigation-ID renaming, collection reordering, ignored operators/literals/outcomes/positions and optional annotations do not alter base scores when validated matching structure is unchanged."},
    {"id":"pair-enumeration","expected":"Unique unordered distinct keys only; reject duplicate input keys; no grouping or display filter mutates accepted pairs."},
    {"id":"stage-short-circuit","expected":"Later stages are not_evaluated after rejection, not zero-score failures."},
    {"id":"invalid-configuration","expected":"Reject unknown keys, variants, nonfinite/out-of-range thresholds; record exact effective decimals."},
    {"id":"resource-failure","expected":"Explicit diagnostic and incomplete-run status; no legacy depth cap, graph-size fallback or silent pair truncation."}
  ]
