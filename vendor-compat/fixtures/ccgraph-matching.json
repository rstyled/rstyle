{
  "fixture_format": {"id": "compat.ccgraph.stage-expectations", "version": "0.1.0"},
  "matching_profile": {"id": "compat.ccgraph.strict", "version": "0.1.0"},
  "authoring": "Hand-worked stage expectations, independent of either analyzer. Compact graphs are projected stage inputs, not PDG-schema documents or proof of extraction eligibility.",
  "validation": {"analyzer_execution": "not_run", "conformance": "not_evaluated", "quality": "not_evaluated"},
  "encoding": {
    "graph_nodes": "Object mapping navigation aliases to one of the five initial labels.",
    "graph_edges": "Array of [source,target,family]; each tuple is a distinct occurrence. No endpoint deduplication.",
    "fractions": "Two-integer arrays [numerator,denominator].",
    "cosine": "{numerator,sqrt_denominator} means numerator/sqrt(sqrt_denominator).",
    "histogram_labels": "Tokens stand for equivalence classes within each round, shared across compared graphs; not implementation hashes.",
    "scope": "Stage isolation is deliberate: a WL fixture does not imply its pair survives size/numerical/string gates. Schema/source validation is exercised separately by future producer harnesses."
  },
  "projection_cases": [
    {
      "id": "retain-values-remove-only-boundaries-and-unreachable",
      "input": {
        "nodes": [
          {"id":"E","category":"entry","administrative":true},
          {"id":"p","category":"formal_input","synthetic":true},
          {"id":"d","category":"declaration","reachable":true},
          {"id":"r","category":"read","reachable":true,"read_symbols":["x"]},
          {"id":"ret","category":"return","reachable":true},
          {"id":"X","category":"exit","administrative":true},
          {"id":"u","category":"computation","reachable":false},
          {"id":"v","category":"read","reachable":false,"read_symbols":["y"]}
        ],
        "edges": [["E","d","execution"],["p","d","data"],["d","r","data"],["r","ret","data"],["d","r","execution"],["r","ret","execution"],["ret","X","execution"],["u","v","data"]]
      },
      "expected": {
        "retained_nodes":["p","d","r","ret"],
        "removed_nodes":["E","X","u","v"],
        "edges":[["p","d","data"],["d","r","data"],["r","ret","data"],["d","r","execution"],["r","ret","execution"]],
        "features":[0,2,3,1,0,0,0,3,1],
        "forbidden":["remove synthetic p","splice E or X","count unreachable y","deduplicate different families on d->r"]
      }
    }
  ],
  "interface_cases": [
    {
      "id":"ordered-inputs-and-single-return",
      "inputs":[["parameter","i32",false],["parameter","bool",false]],
      "outputs":[["return","i32",false]],
      "name":"choose",
      "expected":{"IntroPara":"[[\"parameter\",\"i32\",false],[\"parameter\",\"bool\",false]]","ReturnPara":"[[\"return\",\"i32\",false]]","Name":"choose"}
    },
    {
      "id":"known-no-inputs-and-unit-output",
      "inputs":[],"outputs":[["return","unit",false]],"name":"empty",
      "expected":{"IntroPara":"[]","ReturnPara":"[[\"return\",\"unit\",false]]","Name":"empty"}
    }
  ],
