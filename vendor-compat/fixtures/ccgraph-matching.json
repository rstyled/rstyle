      "expected":{"weights":[1],"overlap_per_round":[4],"overlap_score":[1,1],"larger_coverage":[4,5],"cross_per_round":[10],"self_a_per_round":[8],"self_b_per_round":[13],"cosine_score":{"numerator":10,"sqrt_denominator":104}}
    },
    {
