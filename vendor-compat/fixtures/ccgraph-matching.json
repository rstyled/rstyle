      "b":{"nodes":{"a":"DECL","b":"ASSIGN"},"edges":[["a","b","control"]]},
      "expected":{"h":1,"weights":[2,1],"overlap_per_round":[2,0],"cross_per_round":[2,0],"self_a_per_round":[2,2],"self_b_per_round":[2,2],"overlap_score":[2,3],"cosine_score":{"numerator":4,"sqrt_denominator":36}}
    },
    {
      "id":"parallel-edge-multiplicity-changed",
      "a":{"nodes":{"a":"DECL","b":"ASSIGN"},"edges":[["a","b","data"]]},
      "b":{"nodes":{"a":"DECL","b":"ASSIGN"},"edges":[["a","b","data"],["a","b","data"]]},
      "expected":{"h":1,"weights":[2,1],"overlap_per_round":[2,0],"cross_per_round":[2,0],"self_a_per_round":[2,2],"self_b_per_round":[2,2],"overlap_score":[2,3],"cosine_score":{"numerator":4,"sqrt_denominator":36}}
