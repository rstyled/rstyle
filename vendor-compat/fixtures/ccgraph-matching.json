    {
      "id":"self-loop-zero-depth-known-limitation",
      "a":{"nodes":{"a":"OTHER"},"edges":[["a","a","data"]]},
      "b":{"nodes":{"a":"OTHER"},"edges":[]},
      "expected":{"h":0,"weights":[1],"overlap_per_round":[1],"cross_per_round":[1],"self_a_per_round":[1],"self_b_per_round":[1],"overlap_score":[1,1],"cosine_score":{"numerator":1,"sqrt_denominator":1}},
      "note":"WL stage alone ignores structural self-loop at h=0. This is an explicit limitation, not permission for cyclic R0 extraction. Other gates may differ."
    }
  ],
  "histogram_score_cases": [
