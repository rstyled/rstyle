      "id":"identical-directed-graph",
      "a":{"nodes":{"a":"DECL","b":"ASSIGN"},"edges":[["a","b","data"]]},
      "b":{"nodes":{"a":"DECL","b":"ASSIGN"},"edges":[["a","b","data"]]},
      "expected":{"h":1,"weights":[2,1],"overlap_per_round":[2,2],"cross_per_round":[2,2],"self_a_per_round":[2,2],"self_b_per_round":[2,2],"overlap_score":[1,1],"cosine_score":{"numerator":6,"sqrt_denominator":36}}
