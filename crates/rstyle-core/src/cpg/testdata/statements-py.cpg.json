its own method.\"\"\"\n\n    def __lt__(self, other: \"Version\") -> bool:\n        return True\n\n\ndef between(lo: int, x: int, hi: int) -> bool:\n    \"\"\"Compares numbers, which runs no method.\"\"\"\n    return lo <= x < hi\n\n\ndef ordered(a: Version, b: Version, c: Version) -> bool:\n    \"\"\"Compares versions, which runs their own method, and stops at the first that fails.\"\"\"\n    return a < b < c\n\n\ndef dropped(d: dict[str, int], k: str) -> None:\n    \"\"\"Removes an item.\"\"\"\n    del d[k]\n\n\ndef forgotten(holder: Version, n: int) -> None:\n    \"\"\"Removes an attribute and a name.\"\"\"\n    del holder.name, n\n\n\ndef unpacked(a: int, b: int) -> None:\n    \"\"\"Removes names given as a tuple, which nothing models.\"\"\"\n    del (a, b)\n"}],"namespaces":[{"id":"ns:statements","name":"statements","file":"file:statements.py"}],"imports":[],"definitions":[{"id":"def:py::statements.<module>","stable_identity":"py::statements.<module>","kind":"function","name":"<module>","scope":"unit","span":{"file":"file:statements.py","start":0,"end":805},"compilation":"statements","callable":{"parameters":[],"result":"t1","generics":0,"modifiers":[]}},{"id":"def:py::statements.Version","stable_identity":"py::statements.Version","kind":"type","name":"statements.Version","scope":"unit","compilation":"statements"},{"id":"def:py::statements.Version.<body>","stable_identity":"py::statements.Version.<body>","kind":"function","name":"Version.<body>","scope":"unit","span":{"file":"file:statements.py","start":67,"end":184},"compilation":"statements","callable":{"parameters":[],"result":"t1","generics":0,"modifiers":[]}},{"id":"def:py::statements.Version.__lt__","stable_identity":"py::statements.Version.__lt__","kind":"method","name":"Version.__lt__","scope":"unit","span":{"file":"file:statements.py","start":121,"end":184},"compilation":"statements","callable":{"parameters":["t3"],"result":"t2","generics":0,"modifiers":[],"owner_type":"t3","receiver":"t3"}},{"id":"def