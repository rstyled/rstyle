 pairs(counts: dict[str, int]) -> int:\n    \"\"\"Scans a dict's items.\"\"\"\n    total = 0\n    for key, value in counts.items():\n        total += value\n    return total\n\n\ndef values(counts: dict[str, int]) -> int:\n    \"\"\"Scans a dict's values.\"\"\"\n    total = 0\n    for value in counts.values():\n        total += value\n    return total\n\n\ndef members(seen: set[int]) -> int:\n    \"\"\"Scans a set.\"\"\"\n    total = 0\n    for item in seen:\n        total += item\n    return total\n\n\ndef grown(counts: dict[str, int]) -> int:\n    \"\"\"Adds an entry before scanning, so the scan sees more than the dict held where the function started.\"\"\"\n    counts.update({\"extra\": 0})\n    total = 0\n    for value in counts.values():\n        total += value\n    return total\n"}],"namespaces":[{"id":"ns:containers","name":"containers","file":"file:containers.py"}],"imports":[],"definitions":[{"id":"def:py::_collections_abc.dict_items","stable_identity":"py::_collections_abc.dict_items","kind":"type","name":"_collections_abc.dict_items","scope":"library","standard":true},{"id":"def:py::_collections_abc.dict_values","stable_identity":"py::_collections_abc.dict_values","kind":"type","name":"_collections_abc.dict_values","scope":"library","standard":true},{"id":"def:py::builtins.dict","stable_identity":"py::builtins.dict","kind":"type","name":"builtins.dict","scope":"library","standard":true},{"id":"def:py::builtins.dict.items","stable_identity":"py::builtins.dict.items","kind":"method","name":"builtins.dict.items","scope":"library","standard":true,"operation":"py:dict.items"},{"id":"def:py::builtins.dict.values","stable_identity":"py::builtins.dict.values","kind":"method","name":"builtins.dict.values","scope":"library","standard":true,"operation":"py:dict.values"},{"id":"def:py::containers.<module>","stable_identity":"py::containers.<module>","kind":"function","name":"<module>","scope":"unit","span":{"file":"file:containers.py","start":0,"end":839},"compilatio