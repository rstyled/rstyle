ns ys for each of xs, then prints with a keyword.\"\"\"\n    total = 0\n    for x in xs:\n        for y in ys:\n            total += x * y\n    print(total, end=\"\")\n    return total\n\n\ndef ordered(xs: list[int]) -> list[int]:\n    \"\"\"Hands sorted a flag by keyword.\"\"\"\n    return sorted(xs, reverse=True)\n\n\ndef joined(names: list[str]) -> str:\n    \"\"\"Calls a method with a keyword.\"\"\"\n    return \", \".join(names).encode(errors=\"replace\").decode()\n\n\ndef keyed(xs: list[int]) -> list[int]:\n    \"\"\"Hands sorted a lambda by keyword, which nothing lowers.\"\"\"\n    return sorted(xs, key=lambda x: -x)\n\n\ndef spread(xs: list[int], options: dict[str, bool]) -> list[int]:\n    \"\"\"Unpacks a mapping into keywords, which stays unmodeled.\"\"\"\n    return sorted(xs, **options)\n"}],"namespaces":[{"id":"ns:keywords","name":"keywords","file":"file:keywords.py"}],"imports":[],"definitions":[{"id":"def:py::builtins.bytes","stable_identity":"py::builtins.bytes","kind":"type","name":"builtins.bytes","scope":"library","standard":true},{"id":"def:py::builtins.bytes.decode","stable_identity":"py::builtins.bytes.decode","kind":"method","name":"builtins.bytes.decode","scope":"library","standard":true,"operation":"py:bytes.decode"},{"id":"def:py::builtins.print","stable_identity":"py::builtins.print","kind":"function","name":"builtins.print","scope":"library","standard":true,"operation":"py:print"},{"id":"def:py::builtins.sorted","stable_identity":"py::builtins.sorted","kind":"function","name":"builtins.sorted","scope":"library","standard":true,"operation":"py:sorted"},{"id":"def:py::builtins.str.encode","stable_identity":"py::builtins.str.encode","kind":"method","name":"builtins.str.encode","scope":"library","standard":true,"operation":"py:str.encode"},{"id":"def:py::builtins.str.join","stable_identity":"py::builtins.str.join","kind":"method","name":"builtins.str.join","scope":"library","standard":true,"operation":"py:str.join"},{"id":"def:py::keywords.<m