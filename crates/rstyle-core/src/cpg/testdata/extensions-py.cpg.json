ort asyncio\n\n\ndef labels(xs: list[int]) -> None:\n    \"\"\"Formats each item, which can run the value's own __format__.\"\"\"\n    for x in xs:\n        label = f\"item {x:>4}\"\n\n\ndef constant(xs: list[int]) -> None:\n    \"\"\"Joins an f-string that formats nothing.\"\"\"\n    for x in xs:\n        label = f\"item\"\n\n\ndef rows(xs: list[int]) -> None:\n    \"\"\"Builds a dict display per item, which hashes its keys.\"\"\"\n    for x in xs:\n        row = {\"value\": x, \"square\": x * x}\n\n\ndef tails(xs: list[int], ys: list[int]) -> None:\n    \"\"\"Slices a list per item.\"\"\"\n    for x in xs:\n        tail = ys[x:]\n\n\ndef spread(xs: list[int], ys: list[int]) -> None:\n    \"\"\"Unpacks a list into a tuple per item, which iterates it.\"\"\"\n    for x in xs:\n        both = (*ys, x)\n\n\nasync def waits(future: asyncio.Future[int]) -> int:\n    \"\"\"Awaits a future, which runs its __await__.\"\"\"\n    return await future\n\n\ndef imports() -> None:\n    \"\"\"Imports a module, which can run its code, and binds its name.\"\"\"\n    import json\n\n\ndef named(options: dict[str, bool]) -> dict[str, bool]:\n    \"\"\"Passes one keyword by name and unpacks the rest.\"\"\"\n    return dict(strict=True, **options)\n"}],"namespaces":[{"id":"ns:extensions","name":"extensions","file":"file:extensions.py"}],"imports":[{"id":"import0","namespace":"ns:extensions","path":"asyncio","reason":"rstyle-py records an import without its target","span":{"file":"file:extensions.py","start":106,"end":113}},{"id":"import1","namespace":"ns:extensions","path":"json","reason":"rstyle-py records an import without its target","span":{"file":"file:extensions.py","start":1085,"end":1089}}],"definitions":[{"id":"def:py::_asyncio.Future","stable_identity":"py::_asyncio.Future","kind":"type","name":"_asyncio.Future","scope":"library","standard":true,"destructor":true},{"id":"def:py::builtins.dict","stable_identity":"py::builtins.dict","kind":"type","name":"builtins.dict","scope":"l