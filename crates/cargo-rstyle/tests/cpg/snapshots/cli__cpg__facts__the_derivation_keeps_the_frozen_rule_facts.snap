    "source": "pub fn classify(values: &[i64], flag: bool) -> &'static str {\n    if let Some(&head) = values.first()\n        && head < -100\n    {\n        return \"deep\";\n    }\n    match values {\n        [] => \"empty\",\n        [first, .., last] if *first == *last || flag => \"bracketed\",\n        [1..=9, rest @ ..] if !rest.is_empty() => \"digit\",\n        [value] if *value < 0 => \"negative\",\n        [0 | 1] => \"bit\",\n        _ => \"other\",\n    }\n}",
    "preceding_line": "",
