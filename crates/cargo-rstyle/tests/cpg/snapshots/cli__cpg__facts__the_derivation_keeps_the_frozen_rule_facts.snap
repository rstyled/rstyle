    "source": "pub fn destructure(values: [i64; 3], point: &mut Point) -> i64 {\n    let (mut a, mut b, mut last) = (0, 0, 0);\n    (a, b) = (values[0], values[1]);\n    Pair(a, b) = Pair(b, a);\n    [.., last] = values;\n    Point { x: point.y, tags: [point.tags[1], _], .. } = Point::default();\n    _ = last;\n    match last {\n        0 => _ = a,\n        _ => (a, b) = (b, a),\n    }\n    a + b + last\n}",
