    "source": "pub fn drain(&self, limit: u32) -> u32 {\n        let mut pending = vec![1, 2, 3];\n        let mut total = 0;\n        while let Some(next) = pending.pop() {\n            total += next;\n        }\n        'outer: for row in &self.items {\n            for item in row {\n                if *item == limit {\n                    break 'outer;\n                }\n            }\n        }\n        total\n    }",
    "preceding_line": "",
