    "source": "pub fn first_even(values: &[u32]) -> Option<u32> {\n    let halves: Vec<u32> = values.iter().copied().map(half).collect();\n    let mut index = 0;\n    loop {\n        if index >= halves.len() {\n            break None;\n        }\n        if !halves[index].is_multiple_of(2) {\n            index += 1;\n            continue;\n        }\n        break Some(halves[index]);\n    }\n}",
