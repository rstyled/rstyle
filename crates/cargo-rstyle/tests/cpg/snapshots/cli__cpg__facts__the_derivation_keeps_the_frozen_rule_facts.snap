    "source": "pub fn build(values: &mut [i64], origin: &Point) -> Point {\n    fn double(value: i64) -> i64 {\n        value * 2\n    }\n    values[0] = double(values[0]);\n    let grid = [0u8; LIMIT];\n    let pair = (grid.len(), const { 3 });\n    let mut point = Point { x: pair.0 as i64, ..origin.clone() };\n    point.tags[1] = !point.tags[0];\n    point.y = -point.x;\n    point\n}",
