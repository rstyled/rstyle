    "source": "pub fn effects(&mut self, callback: fn(u32) -> u32) -> u32 {\n        self.bump();\n        let local = |value: u32| value + 1;\n        unsafe { COUNTER += 1 };\n        println!(\"{}\", self.count);\n        let shown = (if self.count > 1 { callback(self.count) } else { local(self.count) }) + 1;\n        shown\n    }",
