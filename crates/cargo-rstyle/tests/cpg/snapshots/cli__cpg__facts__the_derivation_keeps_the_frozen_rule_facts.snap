    "source": "pub fn check_all(&self) -> Result<(), String> {\n        for row in &self.items {\n            for item in row {\n                match item {\n                    0 => continue,\n                    value => {\n                        checked(*value)?\n                    }\n                }\n            }\n        }\n        Ok(())\n    }",
